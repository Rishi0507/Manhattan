flowchart LR
    BANK[("bank statement<br/>one credit")] -.->|"Leg A"| PG
    PG[("PG settlement report<br/>payments, fees")] -->|"Leg B"| OMS[("OMS / ledger<br/>orders")]
    PG -.->|"Leg C"| POL[["fee policy config"]]

    LA["Leg A one to many<br/>reference often missing<br/>narrowing, then exact reconstruction"]
    LB["Leg B one to one, keyed<br/>deterministic join; unmatched rows become orphans"]
    LC["Leg C not a join at all<br/>independent recomputation and comparison"]

    BANK --- LA
    OMS --- LB
    POL --- LC

