flowchart TB
    EX["a settlement that did<br/>not post"] --> T{"deterministic triage:<br/>could any action help?"}
    T -->|"no: amounts do not<br/>distinguish,<br/>or a rival already<br/>appears,<br/>or nothing left to<br/>tighten"| SKIP["not invoked<br/>zero model cost"]
    T -->|"yes"| OBS["observe<br/>status, pool size,<br/>collision index,<br/>twin mass, exact<br/>residual,<br/>everything already tried"]
    OBS --> CH["choose one action<br/>from a closed typed<br/>vocabulary"]
    CH --> ACT["act<br/>the action becomes an<br/>overlay,<br/>which is data"]
    ACT --> VER["re-verify<br/>the ENTIRE stack runs<br/>again, unmodified"]
    VER --> Q{"unique reconstruction?"}
    Q -->|no| OBS
    Q -->|"yes, and an action<br/>cited a real record"| POST["VERIFIED<br/>posts, with the citation"]
    Q -->|"yes, but only because<br/>a filter was changed"| CURE["proven cure<br/>held; the remediation is<br/>verified,<br/>not estimated"]

    style SKIP fill:#f1f3f5,stroke:#6b7480,color:#16181d
    style POST fill:#e7f5ee,stroke:#0a7d4e,color:#16181d
    style CURE fill:#fdf3e7,stroke:#a76100,color:#16181d
    style VER fill:#eaf1fd,stroke:#1461cc,color:#16181d
